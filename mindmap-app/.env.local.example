# mindmap-app の環境変数テンプレート
# 実際の値は .env.local にコピーして記入する（.env.local は git 管理外）
# 本番（Vercel）では Vercel の環境変数に同じものを設定する
# 詳しい有効化手順は ../SECURITY_PRODUCTION.md を参照

# ---------- Firebase（必須） ----------
# NEXT_PUBLIC_* はブラウザに露出する前提の識別子。
# 実際のアクセス制御は Firestore ルールと Functions のトークン検証で行う。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- AI バックエンドの切り替え ----------
# functions を指定すると、ログイン済みユーザーの AI 呼び出しが
# Cloud Functions 経由（IDトークン検証・レートリミット・キャッシュ付き）になる。
# 未指定だと Next.js API Routes（認証なし）にフォールバックする。
NEXT_PUBLIC_AI_BACKEND=functions

# ---------- App Check（REL-06） ----------
# reCAPTCHA v3 のサイトキー。設定すると App Check が有効になる。
# 公開値なのでブラウザに出て問題ない（シークレットキーは Firebase コンソールにのみ入れる）。
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ローカル開発でのみ使うデバッグトークン。
# 本番環境には絶対に設定しないこと（App Check の検証を素通りできてしまう）。
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# ---------- 未認証 AI 経路（REL-06） ----------
# /api/ai/* は認証を要求しないため、本番では既定で閉じている。
# on にすると未ログインでも AI を使えるが、Groq のタダ乗りを許すことになる。
# 開ける場合は App Check の適用と共有ストアでのレートリミットをセットで導入すること。
# AI_PUBLIC_FALLBACK=off

# このプロセス全体で1時間に許可する回数（上を on にしたときのみ意味を持つ）
# AI_PUBLIC_HOURLY_LIMIT=300

# ---------- 利用状況の計測（REL-10） ----------
# Firebase コンソール → プロジェクトの設定 → 全般 → ウェブアプリ に表示される
# measurementId（G-XXXXXXXXXX）。未設定なら計測は一切行われない。
# 有効にする場合は Firebase コンソールで Google Analytics を連携しておくこと。
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- エラー収集（REL-09） ----------
# Sentry プロジェクトの DSN。未設定なら Sentry は初期化されず送信も発生しない。
# DSN は公開前提の値（送信先を示すだけで、データの読み出し権限は無い）。
NEXT_PUBLIC_SENTRY_DSN=

# 環境名。未設定なら Vercel の VERCEL_ENV / Netlify の CONTEXT を自動で使う
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# パフォーマンストレースの採取率（0〜1）。本番の既定は 0.1、開発は 0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ソースマップのアップロード用（ビルド時のみ・サーバー側で使う秘密情報）。
# 未設定ならアップロードをスキップするだけでビルドは通る。
# 設定するとスタックトレースが読める形になる。
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ---------- ローカルで Functions を使わない場合のみ ----------
# API Routes 経由で直接 Groq を呼ぶときに必要。
# 本番では Secret Manager 管理なので設定しない。
# GROQ_API_KEY=
