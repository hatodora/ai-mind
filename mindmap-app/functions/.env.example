# Cloud Functions の環境変数テンプレート（REL-06）
# 実際の値は functions/.env にコピーして記入する
# 詳しい有効化手順は ../../SECURITY_PRODUCTION.md を参照

# ---------- App Check の強制 ----------
# true にすると、正規のアプリ以外からの Functions 呼び出しを拒否する。
# 前提: クライアントに NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY を設定し、
# Firebase コンソールで検証済み比率が十分に上がったことを確認してから true にする。
# いきなり true にすると、古いページを開いている利用者が弾かれる。
ENFORCE_APP_CHECK=false

# ---------- レートリミット ----------
# 1ユーザーが1日に呼べる AI の最大回数
AI_DAILY_LIMIT=120

# 全ユーザー合計の1日あたり上限（課金の暴走を止めるサーキットブレーカー）。
# ここに達すると全利用者の AI が止まるので、想定コストから逆算して決める。
AI_GLOBAL_DAILY_LIMIT=3000

# GROQ_API_KEY はここではなく Secret Manager で管理する:
#   firebase functions:secrets:set GROQ_API_KEY
